{
  "name": "petblitz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/database",
    "db:verify": "tsx scripts/verify-database.ts",
    "db:indexes": "tsx scripts/create-indexes.ts",
    "db:indexes:dry": "tsx scripts/create-indexes.ts --dry-run",
    "db:seed:categories": "tsx scripts/seed-categories.ts",
    "db:seed:categories:dry": "tsx scripts/seed-categories.ts --dry-run",
    "db:report": "tsx scripts/database-report.ts",
    "db:release-expired": "tsx scripts/release-expired.ts",
    "auth:dev-token": "tsx scripts/dev-session-token.ts",
    "docs:generate": "tsx scripts/generate-api-docs.ts",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "google-auth-library": "^11.3.0",
    "mongoose": "^8.9.0",
    "next": "^15.1.0",
    "nodemailer": "^10.2.1",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "recharts": "^3.10.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
